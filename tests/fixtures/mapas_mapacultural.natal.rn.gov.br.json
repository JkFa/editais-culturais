  "id": 316,
  "name": "EDITAL DE SELEÇÃO PÚBLICA PARA O 17º SALÃO DE ARTES VISUAIS DA CIDADE DE NATAL - 2026",
  "shortDescription": "EDITAL DA SELEÇÃO PÚBLICA Nº 19/2026-FUNCARTE PARA O 17º SALÃO DE ARTES VISUAIS DA CIDADE DE NATAL - 2026.  PAE Nº Funcarte-20261108891",
  "registrationFrom": {
   "date": "2026-10-06 18:00:00.000000",
   "timezone_type": 3,
   "timezone": "Etc/GMT+3"
  },
  "registrationTo": {
   "date": "2026-11-22 23:59:00.000000",
