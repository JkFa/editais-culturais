[
 {
  "id": 587,
  "name": "Convocatoria de Movilidad IberCultura Viva 2026/Edital de Mobilidade IberCulturaViva 2026",
  "shortDescription": "⭕ Convocatoria de Movilidad IberCultura Viva\nParticipación en el 7° Congreso Latinoamericano y Caribeño de Culturas Vivas Comunitarias 2026\n\n⭕ Edital de Mobilidade IberCultura Viva\nParticipação no 7º Congresso Latino-americano e Caribenho de Culturas Vivas Comunitárias 2026",
  "registrationFrom": {
   "date": "2026-01-06 16:00:00.000000",
   "timezone_type": 3,
   "timezone": "Etc/GMT+3"
  },
  "registrationTo": {
   "date": "2026-01-23 13:00:00.000000",
   "timezone_type": 3,
   "timezone": "Etc/GMT+3"
  },
  "createTimestamp": {
   "date": "2026-01-03 18:57:57.000000",
