# Copie para .env (ignorado pelo git) e preencha. Nunca versione valores reais.

# Supabase (Settings > API). Sem estas duas, o worker roda em modo --dry-run.
SUPABASE_URL=
# Chave service_role: só no worker/Secrets do GitHub. NUNCA no front-end.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: habilita o enriquecimento por LLM (Gemini). Sem ela, só regex.
GEMINI_API_KEY=
# Opcional: modelo e limite de chamadas por execução.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_POR_EXECUCAO=60
